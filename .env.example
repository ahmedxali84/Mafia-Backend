# Port the server listens on (Render/Railway set this automatically)
PORT=4000
# production disables the debug bot buttons
NODE_ENV=development
# Frontend URL(s) allowed by CORS, comma separated. Empty = defaults:
# https://mafia-frontend-lyart.vercel.app, http://localhost:3000, http://127.0.0.1:3000
CLIENT_ORIGIN=
# Set to true to keep "Add bots" in production
ENABLE_DEBUG=false
# Optional TURN relay for voice chat (players behind strict NATs), e.g. turn:turn.example.com:3478
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
# Feedback form: the secret that lets the team read GET /feedback (Authorization: Bearer <token>).
# Empty = nobody can read it over HTTP. Make it long and random; never commit the real value.
FEEDBACK_TOKEN=
# Where feedback is saved (JSON lines). Render's free disk is wiped on redeploy.
FEEDBACK_FILE=
# ── Accounts (week 7): Google login + saved win/loss stats. Leave empty to keep accounts off. ──
# MongoDB connection string (e.g. MongoDB Atlas free tier). Empty = stats are not saved.
MONGODB_URI=
# Database name (default: mafia)
MONGODB_DB=
# Shared secret for game tokens. MUST be the same value as GAME_TOKEN_SECRET on the frontend (Vercel).
# Long and random, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`. Never commit it.
GAME_TOKEN_SECRET=
