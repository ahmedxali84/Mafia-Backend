# Port the server listens on (Render/Railway set this automatically)
PORT=4000
# production disables the debug bot buttons
NODE_ENV=development
# Frontend URL(s) allowed by CORS, comma separated. Leave empty locally (allows all).
# e.g. CLIENT_ORIGIN=https://mafia-frontend.vercel.app
CLIENT_ORIGIN=
# Set to true to keep "Add bots" in production
ENABLE_DEBUG=false
# Optional TURN relay for voice chat (players behind strict NATs), e.g. turn:turn.example.com:3478
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
